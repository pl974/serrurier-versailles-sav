---
/**
 * Page de détail d'un article de blog
 * Route dynamique basée sur le slug de l'article
 */

import Layout from '../../layouts/Layout.astro';
import SEO from '../../components/SEO.astro';
import FloatingCTA from '../../components/FloatingCTA.astro';
import BlogCard from '../../components/BlogCard.astro';
import { blogPosts, getPostBySlug, getRecentPosts } from '../../data/blogPosts';
import type { BlogPost } from '../../data/blogPosts';

export async function getStaticPaths() {
  return blogPosts.map(post => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const relatedPosts = getRecentPosts(3).filter(p => p.id !== post.id).slice(0, 2);

// Formater la date
function formatDate(dateString: string): string {
  const date = new Date(dateString);
  return new Intl.DateTimeFormat('fr-FR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  }).format(date);
}

// Couleurs par catégorie
const categoryColors = {
  guide: 'bg-blue-100 text-blue-800',
  conseils: 'bg-green-100 text-green-800',
  actualites: 'bg-purple-100 text-purple-800',
  securite: 'bg-red-100 text-red-800'
};

const categoryLabels = {
  guide: 'Guide',
  conseils: 'Conseils',
  actualites: 'Actualités',
  securite: 'Sécurité'
};

// Schema.org Article markup
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.excerpt,
  image: post.image,
  datePublished: post.publishedAt,
  dateModified: post.updatedAt || post.publishedAt,
  author: {
    '@type': 'Person',
    name: post.author
  },
  publisher: {
    '@type': 'Organization',
    name: 'Serrurier Versailles SAV',
    logo: {
      '@type': 'ImageObject',
      url: 'https://serrurier-versailles-sav.fr/logo.png'
    }
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `https://serrurier-versailles-sav.fr/blog/${post.slug}`
  }
};
---

<Layout>
  <SEO
    slot="head"
    title={`${post.title} | Blog Serrurier Versailles`}
    description={post.excerpt}
    canonical={`https://serrurier-versailles-sav.fr/blog/${post.slug}`}
    image={post.image}
  />

  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  {/* Fil d'Ariane */}
  <nav class="bg-secondary-50 py-4 border-b border-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center gap-2 text-sm text-secondary-600">
        <li>
          <a href="/" class="hover:text-primary-600 transition-colors">Accueil</a>
        </li>
        <li>
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
          </svg>
        </li>
        <li>
          <a href="/blog" class="hover:text-primary-600 transition-colors">Blog</a>
        </li>
        <li>
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
          </svg>
        </li>
        <li class="text-secondary-900 font-medium truncate max-w-xs">
          {post.title}
        </li>
      </ol>
    </div>
  </nav>

  {/* Article Header */}
  <article class="py-12 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      {/* Meta info */}
      <div class="flex flex-wrap items-center gap-4 mb-6">
        <span class={`px-3 py-1 rounded-full text-sm font-semibold ${categoryColors[post.category]}`}>
          {categoryLabels[post.category]}
        </span>
        <div class="flex items-center gap-2 text-secondary-600">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
        </div>
        <div class="flex items-center gap-2 text-secondary-600">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span>{post.readingTime} min de lecture</span>
        </div>
      </div>

      {/* Titre */}
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold text-secondary-900 mb-6 leading-tight">
        {post.title}
      </h1>

      {/* Extrait */}
      <p class="text-xl text-secondary-600 mb-8 leading-relaxed">
        {post.excerpt}
      </p>

      {/* Auteur */}
      <div class="flex items-center gap-3 pb-8 border-b border-gray-200 mb-8">
        <div class="w-12 h-12 bg-primary-100 rounded-full flex items-center justify-center">
          <svg class="w-6 h-6 text-primary-600" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
          </svg>
        </div>
        <div>
          <div class="font-semibold text-secondary-900">{post.author}</div>
          <div class="text-sm text-secondary-600">Expert en serrurerie à Versailles</div>
        </div>
      </div>

      {/* Image principale */}
      <div class="mb-12 rounded-xl overflow-hidden shadow-2xl">
        <img
          src={post.image}
          alt={post.title}
          class="w-full h-auto"
          loading="eager"
        />
      </div>

      {/* Contenu de l'article */}
      <div class="prose prose-lg max-w-none">
        <div class="article-content" set:html={post.content.replace(/\n/g, '<br>')} />
      </div>

      {/* Tags */}
      {post.tags.length > 0 && (
        <div class="mt-12 pt-8 border-t border-gray-200">
          <h3 class="text-sm font-semibold text-secondary-900 mb-3">Mots-clés :</h3>
          <div class="flex flex-wrap gap-2">
            {post.tags.map(tag => (
              <span class="bg-secondary-100 text-secondary-700 px-4 py-2 rounded-full text-sm font-medium hover:bg-primary-100 hover:text-primary-700 transition-colors cursor-pointer">
                #{tag}
              </span>
            ))}
          </div>
        </div>
      )}

      {/* Partage social */}
      <div class="mt-12 pt-8 border-t border-gray-200">
        <h3 class="text-sm font-semibold text-secondary-900 mb-4">Partager cet article :</h3>
        <div class="flex flex-wrap gap-3">
          <button
            onclick={`window.open('https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(`https://serrurier-versailles-sav.fr/blog/${post.slug}`)}', '_blank', 'width=600,height=400')`}
            class="flex items-center gap-2 bg-[#1877F2] hover:bg-[#166FE5] text-white px-4 py-2 rounded-lg font-medium transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            Facebook
          </button>
          <button
            onclick={`window.open('https://twitter.com/intent/tweet?url=${encodeURIComponent(`https://serrurier-versailles-sav.fr/blog/${post.slug}`)}&text=${encodeURIComponent(post.title)}', '_blank', 'width=600,height=400')`}
            class="flex items-center gap-2 bg-[#1DA1F2] hover:bg-[#1A91DA] text-white px-4 py-2 rounded-lg font-medium transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
            </svg>
            Twitter
          </button>
          <button
            onclick={`window.open('https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`https://serrurier-versailles-sav.fr/blog/${post.slug}`)}', '_blank', 'width=600,height=400')`}
            class="flex items-center gap-2 bg-[#0077B5] hover:bg-[#006399] text-white px-4 py-2 rounded-lg font-medium transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            LinkedIn
          </button>
        </div>
      </div>
    </div>
  </article>

  {/* CTA intermédiaire */}
  <section class="py-16 bg-gradient-to-br from-primary-600 to-secondary-900 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-8 md:p-12 border border-white/20">
        <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4">
          Une urgence serrurerie ?
        </h2>
        <p class="text-xl text-primary-100 mb-8">
          Intervention rapide 24h/24 partout à Versailles et alentours
        </p>
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href="tel:01XXXXXXXX"
            class="inline-flex items-center gap-2 bg-white hover:bg-primary-50 text-primary-600 px-8 py-4 rounded-lg font-bold text-lg transition-all hover:scale-105 shadow-lg"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
            </svg>
            01 XX XX XX XX
          </a>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 bg-transparent hover:bg-white/10 text-white px-8 py-4 rounded-lg font-bold text-lg transition-all border-2 border-white"
          >
            Demander un devis
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Articles similaires */}
  {relatedPosts.length > 0 && (
    <section class="py-16 bg-secondary-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-secondary-900 mb-4">
            Articles similaires
          </h2>
          <p class="text-lg text-secondary-600">
            Continuez votre lecture avec ces articles recommandés
          </p>
        </div>
        <div class="grid md:grid-cols-2 gap-8">
          {relatedPosts.map(relatedPost => (
            <BlogCard post={relatedPost} />
          ))}
        </div>
        <div class="text-center mt-12">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 bg-primary-600 hover:bg-primary-700 text-white px-8 py-4 rounded-lg font-bold text-lg transition-all hover:scale-105 shadow-lg"
          >
            Voir tous les articles
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </section>
  )}

  <FloatingCTA />
</Layout>

<style>
  /* Styles pour le contenu markdown */
  .article-content {
    @apply text-secondary-700 leading-relaxed;
  }

  .article-content :global(h1) {
    @apply text-3xl md:text-4xl font-heading font-bold text-secondary-900 mt-12 mb-6;
  }

  .article-content :global(h2) {
    @apply text-2xl md:text-3xl font-heading font-bold text-secondary-900 mt-10 mb-4;
  }

  .article-content :global(h3) {
    @apply text-xl md:text-2xl font-heading font-bold text-secondary-900 mt-8 mb-3;
  }

  .article-content :global(p) {
    @apply mb-6 text-lg;
  }

  .article-content :global(ul) {
    @apply mb-6 ml-6 space-y-2;
  }

  .article-content :global(li) {
    @apply text-lg relative pl-2;
  }

  .article-content :global(li::before) {
    content: "•";
    @apply absolute left-0 text-primary-600 font-bold;
  }

  .article-content :global(strong) {
    @apply font-bold text-secondary-900;
  }

  .article-content :global(a) {
    @apply text-primary-600 hover:text-primary-700 underline;
  }
</style>
