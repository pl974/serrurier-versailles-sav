---
/**
 * Page de contact avec formulaire optimisé
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import CTASection from '@components/CTASection.astro';

const title = 'Contactez-nous - Serrurier à Versailles disponible 24h/24';
const description = 'Contactez votre serrurier à Versailles par téléphone au 01 XX XX XX XX ou via notre formulaire. Service d\'urgence disponible 24h/24 et 7j/7.';
---

<BaseLayout title={title} description={description}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-secondary-900 to-secondary-800 text-white py-16 md:py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-heading font-bold mb-6">
          Contactez votre serrurier à Versailles
        </h1>
        <p class="text-xl text-secondary-100 mb-8">
          Nous sommes à votre écoute 24h/24 et 7j/7 pour tous vos besoins en serrurerie. Urgence ou demande de devis, contactez-nous maintenant.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact rapide -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
          <a href="tel:+33-1-XX-XX-XX-XX" class="bg-gradient-to-br from-primary-50 to-white hover:from-primary-100 hover:to-primary-50 p-8 rounded-xl shadow-lg hover:shadow-xl transition-all border border-primary-200 text-center group">
            <div class="w-16 h-16 bg-primary-600 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
            </div>
            <h2 class="text-xl font-heading font-bold text-secondary-900 mb-3">Appelez-nous</h2>
            <p class="text-2xl font-bold text-primary-600 mb-2">01 XX XX XX XX</p>
            <p class="text-sm text-secondary-600">Disponible 24h/24 - 7j/7</p>
          </a>

          <div class="bg-gradient-to-br from-secondary-50 to-white p-8 rounded-xl shadow-lg border border-gray-200 text-center">
            <div class="w-16 h-16 bg-secondary-600 rounded-full flex items-center justify-center mx-auto mb-6">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <h2 class="text-xl font-heading font-bold text-secondary-900 mb-3">Intervention rapide</h2>
            <p class="text-2xl font-bold text-secondary-900 mb-2">20-30 min</p>
            <p class="text-sm text-secondary-600">Partout à Versailles</p>
          </div>

          <div class="bg-gradient-to-br from-secondary-50 to-white p-8 rounded-xl shadow-lg border border-gray-200 text-center">
            <div class="w-16 h-16 bg-secondary-600 rounded-full flex items-center justify-center mx-auto mb-6">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <h2 class="text-xl font-heading font-bold text-secondary-900 mb-3">Zone d'intervention</h2>
            <p class="text-lg font-bold text-secondary-900 mb-2">Versailles et environs</p>
            <p class="text-sm text-secondary-600">Yvelines (78)</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Formulaire -->
  <section class="py-16 md:py-20 bg-gradient-to-br from-secondary-50 to-white">
    <div class="container mx-auto px-4">
      <CTASection variant="secondary" showForm={true} />
    </div>
  </section>

  <!-- Informations pratiques -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-secondary-900 mb-12 text-center">
          Pourquoi nous contacter ?
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="bg-gradient-to-br from-secondary-50 to-white rounded-xl p-8 shadow-lg">
            <h3 class="text-xl font-heading font-bold text-secondary-900 mb-4 flex items-center gap-3">
              <svg class="w-6 h-6 text-primary-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Urgence serrurerie
            </h3>
            <p class="text-secondary-700">
              Porte claquée, clé perdue, serrure cassée ? Appelez-nous immédiatement pour une intervention en moins de 30 minutes à Versailles.
            </p>
          </div>

          <div class="bg-gradient-to-br from-secondary-50 to-white rounded-xl p-8 shadow-lg">
            <h3 class="text-xl font-heading font-bold text-secondary-900 mb-4 flex items-center gap-3">
              <svg class="w-6 h-6 text-primary-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Devis gratuit
            </h3>
            <p class="text-secondary-700">
              Besoin d'un devis pour un changement de serrure ou une installation ? Contactez-nous pour obtenir une estimation gratuite et sans engagement.
            </p>
          </div>

          <div class="bg-gradient-to-br from-secondary-50 to-white rounded-xl p-8 shadow-lg">
            <h3 class="text-xl font-heading font-bold text-secondary-900 mb-4 flex items-center gap-3">
              <svg class="w-6 h-6 text-primary-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Conseils sécurité
            </h3>
            <p class="text-secondary-700">
              Vous souhaitez renforcer la sécurité de votre habitation ? Nos experts vous conseillent sur les meilleures solutions adaptées à vos besoins.
            </p>
          </div>

          <div class="bg-gradient-to-br from-secondary-50 to-white rounded-xl p-8 shadow-lg">
            <h3 class="text-xl font-heading font-bold text-secondary-900 mb-4 flex items-center gap-3">
              <svg class="w-6 h-6 text-primary-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Rendez-vous planifié
            </h3>
            <p class="text-secondary-700">
              Pour une installation de serrure multipoints ou un blindage de porte, prenez rendez-vous à l'horaire qui vous convient.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
