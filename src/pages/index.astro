---
/**
 * Page d'accueil - Optimisée pour le SEO et la conversion
 * Cible les mots-clés principaux de la serrurerie à Versailles
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import CTASection from '@components/CTASection.astro';
import ServiceCard from '@components/ServiceCard.astro';
import CityCard from '@components/CityCard.astro';
import Testimonial from '@components/Testimonial.astro';
import TrustBadges from '@components/TrustBadges.astro';
import BeforeAfter from '@components/BeforeAfter.astro';
import Stats from '@components/Stats.astro';
import ProcessSteps from '@components/ProcessSteps.astro';
import ImageGallery from '@components/ImageGallery.astro';
import PriceComparison from '@components/PriceComparison.astro';
import FloatingCTA from '@components/FloatingCTA.astro';
import { services, getServicesByUrgency } from '@data/services';
import { getMainCities } from '@data/cities';
import { testimonials } from '@data/testimonials';
import { galleryImages, beforeAfterImages } from '@data/gallery';

const urgentServices = getServicesByUrgency('urgente');
const featuredServices = services.slice(0, 6);
const mainCities = getMainCities();

const title = 'Serrurier à Versailles - Dépannage urgent 24h/24 dans les Yvelines (78)';
const description = 'Serrurier professionnel à Versailles disponible 24h/24 et 7j/7. Ouverture de porte, changement de serrure, dépannage urgent. Intervention en 30 minutes. Devis gratuit.';
---

<BaseLayout title={title} description={description}>
  <!-- Hero Section - Au-dessus de la ligne de flottaison -->
  <section class="bg-gradient-to-br from-primary-600 via-primary-700 to-primary-800 text-white py-16 md:py-24">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">
          Serrurier à Versailles
          <span class="block text-primary-200 mt-2">Intervention rapide en 30 minutes</span>
        </h1>
        <p class="text-xl md:text-2xl text-primary-100 mb-8 max-w-3xl mx-auto">
          Service professionnel de serrurerie disponible 24h/24 et 7j/7 à Versailles et dans tout le département des Yvelines. Dépannage urgent, ouverture de porte, changement de serrure et sécurisation.
        </p>

        <!-- CTA Principal -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12">
          <a
            href="tel:+33-1-XX-XX-XX-XX"
            class="group bg-white text-primary-600 hover:bg-primary-50 px-8 py-5 rounded-xl font-bold text-xl transition-all hover:scale-105 shadow-2xl flex items-center gap-3 w-full sm:w-auto justify-center"
          >
            <svg class="w-7 h-7 group-hover:animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <span>01 XX XX XX XX</span>
          </a>
          <a
            href="#devis"
            class="border-2 border-white text-white hover:bg-white hover:text-primary-600 px-8 py-5 rounded-xl font-bold text-xl transition-all w-full sm:w-auto text-center"
          >
            Devis gratuit
          </a>
        </div>

        <!-- Trust indicators -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 max-w-4xl mx-auto">
          <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4">
            <div class="text-3xl font-bold mb-1">24h/24</div>
            <div class="text-sm text-primary-100">Service disponible</div>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4">
            <div class="text-3xl font-bold mb-1">30 min</div>
            <div class="text-sm text-primary-100">Temps d'intervention</div>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4">
            <div class="text-3xl font-bold mb-1">15 ans</div>
            <div class="text-sm text-primary-100">D'expérience</div>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4">
            <div class="text-3xl font-bold mb-1">100%</div>
            <div class="text-sm text-primary-100">Clients satisfaits</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services d'urgence -->
  <section class="py-16 md:py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-secondary-900 mb-4">
          Services d'urgence disponibles maintenant
        </h2>
        <p class="text-lg text-secondary-600 max-w-3xl mx-auto">
          Nos serruriers professionnels interviennent rapidement pour tous vos besoins urgents de serrurerie à Versailles et ses environs. Service disponible 24h/24, 7 jours sur 7, même les jours fériés.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
        {urgentServices.map((service, index) => (
          <div class="fade-on-scroll" style={`animation-delay: ${index * 100}ms`}>
            <ServiceCard service={service} featured={index === 0} />
          </div>
        ))}
      </div>

      <div class="text-center">
        <a href="/services" class="inline-block bg-secondary-900 hover:bg-secondary-800 text-white px-8 py-4 rounded-lg font-bold text-lg transition-all hover:scale-105">
          Découvrir tous nos services →
        </a>
      </div>
    </div>
  </section>

  <!-- Pourquoi nous choisir -->
  <section class="py-16 md:py-20 bg-gradient-to-br from-secondary-50 to-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-secondary-900 mb-4">
          Pourquoi choisir notre service de serrurerie ?
        </h2>
        <p class="text-lg text-secondary-600 max-w-3xl mx-auto">
          Expertise reconnue, intervention rapide et tarifs transparents font de nous le premier choix pour vos besoins en serrurerie à Versailles.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
        <div class="bg-white rounded-xl p-8 shadow-lg hover:shadow-xl transition-shadow">
          <div class="w-16 h-16 bg-primary-100 rounded-full flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
          <h3 class="text-xl font-heading font-bold text-secondary-900 mb-3">Intervention rapide</h3>
          <p class="text-secondary-600">
            Nos équipes sont disponibles 24h/24 et interviennent en moins de 30 minutes partout à Versailles et dans les communes environnantes. Service d'urgence garanti même les jours fériés.
          </p>
        </div>

        <div class="bg-white rounded-xl p-8 shadow-lg hover:shadow-xl transition-shadow">
          <div class="w-16 h-16 bg-primary-100 rounded-full flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <h3 class="text-xl font-heading font-bold text-secondary-900 mb-3">Serruriers certifiés</h3>
          <p class="text-secondary-600">
            Tous nos serruriers sont certifiés et possèdent plus de 15 ans d'expérience. Ils maîtrisent toutes les techniques d'ouverture non destructive et l'installation de serrures certifiées A2P.
          </p>
        </div>

        <div class="bg-white rounded-xl p-8 shadow-lg hover:shadow-xl transition-shadow">
          <div class="w-16 h-16 bg-primary-100 rounded-full flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="text-xl font-heading font-bold text-secondary-900 mb-3">Tarifs transparents</h3>
          <p class="text-secondary-600">
            Devis gratuit par téléphone avant toute intervention. Pas de frais cachés, nos tarifs sont clairs et compétitifs. Possibilité de prise en charge par votre assurance habitation.
          </p>
        </div>

        <div class="bg-white rounded-xl p-8 shadow-lg hover:shadow-xl transition-shadow">
          <div class="w-16 h-16 bg-primary-100 rounded-full flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
          </div>
          <h3 class="text-xl font-heading font-bold text-secondary-900 mb-3">Matériel professionnel</h3>
          <p class="text-secondary-600">
            Nos véhicules sont équipés de tout le matériel nécessaire pour intervenir efficacement. Nous travaillons uniquement avec des marques reconnues pour leur fiabilité et leur sécurité.
          </p>
        </div>

        <div class="bg-white rounded-xl p-8 shadow-lg hover:shadow-xl transition-shadow">
          <div class="w-16 h-16 bg-primary-100 rounded-full flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
          </div>
          <h3 class="text-xl font-heading font-bold text-secondary-900 mb-3">Sécurité garantie</h3>
          <p class="text-secondary-600">
            Installation de serrures certifiées A2P conformes aux normes d'assurance. Conseils personnalisés pour renforcer la sécurité de votre domicile ou local professionnel.
          </p>
        </div>

        <div class="bg-white rounded-xl p-8 shadow-lg hover:shadow-xl transition-shadow">
          <div class="w-16 h-16 bg-primary-100 rounded-full flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <h3 class="text-xl font-heading font-bold text-secondary-900 mb-3">Couverture locale</h3>
          <p class="text-secondary-600">
            Service disponible à Versailles et dans toutes les communes environnantes : Le Chesnay, Viroflay, Vélizy, Saint-Cyr, Jouy-en-Josas et bien d'autres. Zone d'intervention étendue.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Tous les services -->
  <section class="py-16 md:py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-secondary-900 mb-4">
          Nos prestations de serrurerie à Versailles
        </h2>
        <p class="text-lg text-secondary-600 max-w-3xl mx-auto">
          Du dépannage d'urgence à l'installation de systèmes de sécurité avancés, nous couvrons tous vos besoins en serrurerie pour particuliers et professionnels.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredServices.map((service, index) => (
          <div class="fade-on-scroll" style={`animation-delay: ${index * 100}ms`}>
            <ServiceCard service={service} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Trust Badges -->
  <section class="py-16 bg-gradient-to-br from-secondary-50 to-white">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-secondary-900 mb-12 text-center">
          Vos garanties de confiance
        </h2>
        <TrustBadges showCertifications={true} showGuarantees={true} showPayments={true} />
      </div>
    </div>
  </section>

  <!-- Statistiques -->
  <section class="py-16 md:py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-secondary-900 mb-4">
            Des chiffres qui parlent
          </h2>
          <p class="text-lg text-secondary-600 max-w-3xl mx-auto">
            Notre expertise et notre engagement au service de votre sécurité depuis plus de 15 ans.
          </p>
        </div>
        <Stats
          stats={[
            {
              value: '15',
              label: 'Ans d\'expérience',
              suffix: '+',
              description: 'Au service des Versaillais'
            },
            {
              value: '5000',
              label: 'Interventions',
              suffix: '+',
              description: 'Dépannages réalisés'
            },
            {
              value: '98',
              label: 'Satisfaction client',
              suffix: '%',
              description: 'Taux de satisfaction'
            },
            {
              value: '20',
              label: 'Temps moyen',
              suffix: ' min',
              description: 'D\'intervention à Versailles'
            }
          ]}
          variant="colorful"
        />
      </div>
    </div>
  </section>

  <!-- Nos réalisations (Avant/Après) -->
  <section class="py-16 md:py-20 bg-gradient-to-br from-secondary-50 to-white">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-secondary-900 mb-4">
            Nos réalisations récentes
          </h2>
          <p class="text-lg text-secondary-600 max-w-3xl mx-auto">
            Découvrez la qualité de notre travail à travers nos dernières interventions. Professionnalisme et finition soignée garantis.
          </p>
        </div>

        <div class="space-y-8">
          {beforeAfterImages.map((image, index) => (
            <div class="fade-on-scroll" style={`animation-delay: ${index * 150}ms`}>
              <BeforeAfter
                beforeImage={image.beforeImage}
                afterImage={image.afterImage}
                title={image.title}
                description={image.description}
              />
            </div>
          ))}
        </div>

        <div class="mt-12 text-center">
          <p class="text-secondary-600 mb-6">
            Plus de 5000 interventions réussies à Versailles et ses environs
          </p>
          <a href="/contact" class="inline-block bg-primary-600 hover:bg-primary-700 text-white px-8 py-4 rounded-lg font-bold text-lg transition-all hover:scale-105 shadow-lg">
            Demander un devis pour votre projet
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Processus d'intervention -->
  <section class="py-16 md:py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <ProcessSteps
          title="Comment se déroule notre intervention ?"
          steps={[
            {
              number: 1,
              title: 'Vous nous appelez',
              description: 'Contactez-nous au 01 XX XX XX XX. Nous évaluons votre besoin et vous donnons un devis gratuit immédiat par téléphone.',
              icon: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z'
            },
            {
              number: 2,
              title: 'Intervention rapide',
              description: 'Notre serrurier arrive en moins de 30 minutes à Versailles avec tout le matériel nécessaire pour résoudre votre problème.',
              icon: 'M13 10V3L4 14h7v7l9-11h-7z'
            },
            {
              number: 3,
              title: 'Diagnostic et solution',
              description: 'Le serrurier évalue la situation et procède à l\'intervention : ouverture, réparation ou remplacement selon votre besoin.',
              icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z'
            },
            {
              number: 4,
              title: 'Travail terminé',
              description: 'Votre problème est résolu. Vous recevez une facture détaillée et des conseils d\'entretien. Paiement après intervention.',
              icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'
            }
          ]}
          variant="horizontal"
        />
      </div>
    </div>
  </section>

  <!-- Comparaison de prix -->
  <section class="py-16 md:py-20 bg-gradient-to-br from-secondary-50 to-white">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <PriceComparison />
      </div>
    </div>
  </section>

  <!-- Galerie photos -->
  <section class="py-16 md:py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-secondary-900 mb-4">
            Nos interventions en images
          </h2>
          <p class="text-lg text-secondary-600 max-w-3xl mx-auto">
            Découvrez quelques-unes de nos réalisations de serrurerie à Versailles et ses environs.
          </p>
        </div>

        <ImageGallery
          images={galleryImages}
          columns={3}
          showTitles={false}
        />
      </div>
    </div>
  </section>

  <!-- Témoignages clients -->
  <section class="py-16 md:py-20 bg-gradient-to-br from-primary-50 to-white">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <div class="flex items-center justify-center gap-2 mb-4">
            <div class="flex gap-1">
              {[...Array(5)].map(() => (
                <svg class="w-8 h-8 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>
            <span class="text-2xl font-bold text-secondary-900">5.0/5</span>
          </div>
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-secondary-900 mb-4">
            Ce que disent nos clients
          </h2>
          <p class="text-lg text-secondary-600 max-w-3xl mx-auto">
            La satisfaction de nos clients est notre priorité. Découvrez leurs avis sur nos services de serrurerie.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {testimonials.slice(0, 6).map((testimonial, index) => (
            <div class="fade-on-scroll" style={`animation-delay: ${index * 100}ms`}>
              <Testimonial
                name={testimonial.name}
                city={testimonial.city}
                rating={testimonial.rating}
                comment={testimonial.comment}
                service={testimonial.service}
                date={testimonial.date}
                verified={testimonial.verified}
              />
            </div>
          ))}
        </div>

        <div class="mt-12 text-center">
          <p class="text-secondary-600 text-lg">
            Rejoignez nos <span class="font-bold text-primary-600">5000+ clients satisfaits</span> à Versailles et ses environs
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Zones d'intervention -->
  <section class="py-16 md:py-20 bg-gradient-to-br from-secondary-50 to-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-secondary-900 mb-4">
          Serrurier dans tout le secteur de Versailles
        </h2>
        <p class="text-lg text-secondary-600 max-w-3xl mx-auto">
          Notre service de serrurerie couvre Versailles et toutes les communes environnantes des Yvelines avec des temps d'intervention garantis.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto mb-12">
        {mainCities.slice(0, 6).map((city, index) => (
          <div class="fade-on-scroll" style={`animation-delay: ${index * 100}ms`}>
            <CityCard city={city} />
          </div>
        ))}
      </div>

      <div class="text-center">
        <a href="/villes" class="inline-block bg-primary-600 hover:bg-primary-700 text-white px-8 py-4 rounded-lg font-bold text-lg transition-all hover:scale-105">
          Voir toutes nos zones d'intervention →
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section id="devis" class="py-16 md:py-20 bg-white">
    <div class="container mx-auto px-4">
      <CTASection variant="emergency" showForm={true} />
    </div>
  </section>

  <!-- FAQ Section pour SEO -->
  <section class="py-16 md:py-20 bg-gray-50">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="text-center mb-12">
