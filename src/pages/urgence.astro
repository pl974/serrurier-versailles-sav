---
/**
 * Page urgence - Conversion maximale pour les situations d'urgence
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import CTASection from '@components/CTASection.astro';

const title = 'Serrurier urgence Versailles - Intervention 24h/24 en 30 minutes';
const description = 'Serrurier d\'urgence à Versailles disponible 24h/24 et 7j/7. Porte claquée, clé perdue, serrure cassée ? Intervention garantie en 30 minutes. Appelez maintenant !';
---

<BaseLayout title={title} description={description}>
  <!-- Hero Urgence -->
  <section class="bg-gradient-to-br from-red-600 to-red-700 text-white py-20 md:py-28">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-block bg-white/20 backdrop-blur-sm px-4 py-2 rounded-full text-sm font-semibold mb-6 animate-pulse">
          🚨 SERVICE D'URGENCE DISPONIBLE MAINTENANT
        </div>

        <h1 class="text-5xl md:text-6xl font-heading font-bold mb-6">
          Serrurier d'urgence à Versailles
        </h1>

        <p class="text-2xl md:text-3xl font-bold mb-4">
          Intervention garantie en 30 minutes
        </p>

        <p class="text-xl text-red-100 mb-10">
          Porte claquée ? Clé perdue ? Serrure cassée ? Cambriolage ?<br/>
          Appelez-nous maintenant pour une intervention immédiate
        </p>

        <a href="tel:+33-1-XX-XX-XX-XX" class="inline-flex items-center gap-4 bg-white text-red-600 hover:bg-red-50 px-12 py-6 rounded-2xl font-bold text-2xl transition-all hover:scale-105 shadow-2xl mb-12 animate-pulse">
          <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <div class="text-left">
            <div class="text-sm font-normal text-red-700">Appelez maintenant</div>
            <div>01 XX XX XX XX</div>
          </div>
        </a>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white/10 backdrop-blur-sm rounded-lg p-6">
            <div class="text-4xl font-bold mb-2">24h/24</div>
            <div class="text-red-100">Tous les jours même fériés</div>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-lg p-6">
            <div class="text-4xl font-bold mb-2">30 min</div>
            <div class="text-red-100">Temps d'intervention max</div>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-lg p-6">
            <div class="text-4xl font-bold mb-2">7j/7</div>
            <div class="text-red-100">Week-end et jours fériés</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Situations d'urgence -->
  <section class="py-16 md:py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-secondary-900 mb-12 text-center">
          Nous intervenons pour toutes les urgences
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="bg-gradient-to-br from-red-50 to-white rounded-xl p-8 shadow-lg border-l-4 border-red-600">
            <h3 class="text-2xl font-heading font-bold text-secondary-900 mb-4">Porte claquée</h3>
            <p class="text-secondary-700 mb-4">
              Vous êtes enfermé dehors sans vos clés ? Notre serrurier arrive en moins de 30 minutes et ouvre votre porte sans casser la serrure dans 95% des cas.
            </p>
            <div class="text-primary-600 font-bold">À partir de 89€</div>
          </div>

          <div class="bg-gradient-to-br from-red-50 to-white rounded-xl p-8 shadow-lg border-l-4 border-red-600">
            <h3 class="text-2xl font-heading font-bold text-secondary-900 mb-4">Clé cassée dans serrure</h3>
            <p class="text-secondary-700 mb-4">
              Votre clé s'est cassée dans la serrure ? Nous extrayons le morceau de clé coincé et remplaçons votre serrure si nécessaire. Intervention immédiate.
            </p>
            <div class="text-primary-600 font-bold">Devis gratuit par téléphone</div>
          </div>

          <div class="bg-gradient-to-br from-red-50 to-white rounded-xl p-8 shadow-lg border-l-4 border-red-600">
            <h3 class="text-2xl font-heading font-bold text-secondary-900 mb-4">Après cambriolage</h3>
            <p class="text-secondary-700 mb-4">
              Suite à une effraction, nous sécurisons immédiatement votre domicile et remplaçons toutes les serrures endommagées. Facture pour votre assurance.
            </p>
            <div class="text-primary-600 font-bold">Intervention prioritaire</div>
          </div>

          <div class="bg-gradient-to-br from-red-50 to-white rounded-xl p-8 shadow-lg border-l-4 border-red-600">
            <h3 class="text-2xl font-heading font-bold text-secondary-900 mb-4">Serrure bloquée</h3>
            <p class="text-secondary-700 mb-4">
              Votre serrure est grippée ou bloquée ? Impossible de rentrer chez vous ? Nous débloquons ou remplaçons votre serrure en urgence, jour et nuit.
            </p>
            <div class="text-primary-600 font-bold">Intervention 24h/24</div>
          </div>
        </div>

        <div class="mt-12 text-center">
          <a href="tel:+33-1-XX-XX-XX-XX" class="inline-flex items-center gap-3 bg-red-600 hover:bg-red-700 text-white px-10 py-5 rounded-xl font-bold text-xl transition-all hover:scale-105 shadow-xl">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            Appelez maintenant : 01 XX XX XX XX
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Processus d'intervention -->
  <section class="py-16 md:py-20 bg-gradient-to-br from-secondary-50 to-white">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-secondary-900 mb-12 text-center">
          Comment se déroule l'intervention d'urgence ?
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <div class="text-center">
            <div class="w-20 h-20 bg-red-600 rounded-full flex items-center justify-center mx-auto mb-6">
              <span class="text-4xl font-bold text-white">1</span>
            </div>
            <h3 class="text-xl font-heading font-bold text-secondary-900 mb-3">Vous appelez</h3>
            <p class="text-secondary-600">
              Contactez-nous au 01 XX XX XX XX. Nous décrivez votre situation d'urgence.
            </p>
          </div>

          <div class="text-center">
            <div class="w-20 h-20 bg-red-600 rounded-full flex items-center justify-center mx-auto mb-6">
              <span class="text-4xl font-bold text-white">2</span>
            </div>
            <h3 class="text-xl font-heading font-bold text-secondary-900 mb-3">Devis immédiat</h3>
            <p class="text-secondary-600">
              Nous vous donnons un devis clair par téléphone. Pas de surprise.
            </p>
          </div>

          <div class="text-center">
            <div class="w-20 h-20 bg-red-600 rounded-full flex items-center justify-center mx-auto mb-6">
              <span class="text-4xl font-bold text-white">3</span>
            </div>
            <h3 class="text-xl font-heading font-bold text-secondary-900 mb-3">Intervention rapide</h3>
            <p class="text-secondary-600">
              Le serrurier arrive en moins de 30 minutes avec tout le matériel.
            </p>
          </div>

          <div class="text-center">
            <div class="w-20 h-20 bg-red-600 rounded-full flex items-center justify-center mx-auto mb-6">
              <span class="text-4xl font-bold text-white">4</span>
            </div>
            <h3 class="text-xl font-heading font-bold text-secondary-900 mb-3">Problème résolu</h3>
            <p class="text-secondary-600">
              Votre porte est ouverte ou votre serrure remplacée. Vous recevez la facture.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Garanties -->
  <section class="py-16 md:py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-secondary-900 mb-12 text-center">
          Nos garanties d'urgence
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
              <svg class="w-10 h-10 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
            </div>
            <h3 class="text-xl font-heading font-bold text-secondary-900 mb-3">Intervention garantie 30 min</h3>
            <p class="text-secondary-600">
              Nous nous engageons à arriver en moins de 30 minutes sur Versailles.
            </p>
          </div>

          <div class="text-center">
            <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
              <svg class="w-10 h-10 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
            </div>
            <h3 class="text-xl font-heading font-bold text-secondary-900 mb-3">Tarif fixe annoncé</h3>
            <p class="text-secondary-600">
              Le prix annoncé au téléphone est le prix final. Aucun frais caché.
            </p>
          </div>

          <div class="text-center">
            <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
              <svg class="w-10 h-10 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
            </div>
            <h3 class="text-xl font-heading font-bold text-secondary-900 mb-3">Travail garanti</h3>
            <p class="text-secondary-600">
              Notre intervention est garantie. Si problème, nous revenons gratuitement.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Final -->
  <section class="py-16 md:py-20 bg-gradient-to-br from-red-600 to-red-700 text-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-4xl md:text-5xl font-heading font-bold mb-6">
          Ne restez pas bloqué dehors !
        </h2>
        <p class="text-2xl mb-10">
          Chaque minute compte en situation d'urgence.<br/>
          Appelez maintenant pour une intervention immédiate.
        </p>
        <a href="tel:+33-1-XX-XX-XX-XX" class="inline-flex items-center gap-4 bg-white text-red-600 hover:bg-red-50 px-12 py-6 rounded-2xl font-bold text-2xl transition-all hover:scale-105 shadow-2xl animate-pulse">
          <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          01 XX XX XX XX
        </a>
        <p class="mt-6 text-red-100">
          Service disponible immédiatement - 24h/24 - 7j/7 - Même les jours fériés
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
