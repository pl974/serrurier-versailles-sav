---
/**
 * Page des tarifs - Transparence et confiance
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import CTASection from '@components/CTASection.astro';
import { services } from '@data/services';

const title = 'Tarifs serrurerie Versailles - Prix transparents et devis gratuit';
const description = 'Découvrez nos tarifs de serrurerie à Versailles. Prix clairs et transparents pour ouverture de porte, changement de serrure, blindage. Devis gratuit par téléphone.';
---

<BaseLayout title={title} description={description}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-secondary-900 to-secondary-800 text-white py-16 md:py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-heading font-bold mb-6">
          Tarifs de serrurerie à Versailles
        </h1>
        <p class="text-xl text-secondary-100 mb-8">
          Prix transparents et sans surprise. Devis gratuit par téléphone avant toute intervention. Nos tarifs sont compétitifs et adaptés au marché local de Versailles.
        </p>
        <a href="tel:+33-1-XX-XX-XX-XX" class="inline-flex items-center gap-3 bg-primary-600 hover:bg-primary-700 text-white px-8 py-4 rounded-lg font-bold text-lg transition-all hover:scale-105 shadow-xl">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          Devis gratuit : 01 XX XX XX XX
        </a>
      </div>
    </div>
  </section>

  <!-- Grille de tarifs -->
  <section class="py-16 md:py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-secondary-900 mb-12 text-center">
          Nos prestations et tarifs
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {services.map(service => (
            <div class="bg-gradient-to-br from-secondary-50 to-white rounded-xl p-8 shadow-lg hover:shadow-xl transition-all border border-gray-200">
              <h3 class="text-xl font-heading font-bold text-secondary-900 mb-4">
                {service.title}
              </h3>
              <p class="text-secondary-600 mb-6 text-sm">
                {service.description}
              </p>
              <div class="border-t border-gray-200 pt-6">
                <div class="text-3xl font-bold text-primary-600 mb-2">
                  {service.price}
                </div>
                <a href={`/services/${service.slug}`} class="text-primary-600 hover:text-primary-700 font-semibold text-sm">
                  En savoir plus →
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Informations tarifaires -->
  <section class="py-16 md:py-20 bg-gradient-to-br from-secondary-50 to-white">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-secondary-900 mb-12 text-center">
          Ce qu'il faut savoir sur nos tarifs
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="bg-white rounded-xl p-8 shadow-lg">
            <h3 class="text-xl font-heading font-bold text-secondary-900 mb-4 flex items-center gap-3">
              <svg class="w-6 h-6 text-primary-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Devis gratuit
            </h3>
            <p class="text-secondary-700">
              Nous vous communiquons toujours un devis clair et détaillé par téléphone avant l'intervention. Vous connaissez le prix exact avant que le serrurier ne se déplace.
            </p>
          </div>

          <div class="bg-white rounded-xl p-8 shadow-lg">
            <h3 class="text-xl font-heading font-bold text-secondary-900 mb-4 flex items-center gap-3">
              <svg class="w-6 h-6 text-primary-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Pas de frais cachés
            </h3>
            <p class="text-secondary-700">
              Le tarif annoncé est le tarif final. Il comprend le déplacement, la main d'œuvre et les petites fournitures. Aucune mauvaise surprise sur la facture.
            </p>
          </div>

          <div class="bg-white rounded-xl p-8 shadow-lg">
            <h3 class="text-xl font-heading font-bold text-secondary-900 mb-4 flex items-center gap-3">
              <svg class="w-6 h-6 text-primary-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Prise en charge assurance
            </h3>
            <p class="text-secondary-700">
              Nos interventions peuvent être prises en charge par votre assurance habitation. Nous vous fournissons une facture détaillée conforme aux exigences des assureurs.
            </p>
          </div>

          <div class="bg-white rounded-xl p-8 shadow-lg">
            <h3 class="text-xl font-heading font-bold text-secondary-900 mb-4 flex items-center gap-3">
              <svg class="w-6 h-6 text-primary-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Tarif unique 24h/24
            </h3>
            <p class="text-secondary-700">
              Nos tarifs d'urgence sont fixes, que vous appeliez en journée, la nuit, le weekend ou un jour férié. Pas de majoration nocturne ou festive abusive.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Tarifs -->
  <section class="py-16 md:py-20 bg-white">
    <div class="container mx-auto px-4 max-w-4xl">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-secondary-900 mb-12 text-center">
        Questions fréquentes sur nos tarifs
      </h2>

      <div class="space-y-6">
        <details class="bg-gradient-to-br from-secondary-50 to-white rounded-lg shadow-md p-6 group">
          <summary class="font-heading font-bold text-lg text-secondary-900 cursor-pointer list-none flex items-center justify-between">
            Quels moyens de paiement acceptez-vous ?
            <svg class="w-5 h-5 text-primary-600 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <p class="mt-4 text-secondary-600">
            Nous acceptons les paiements en espèces, par carte bancaire, par chèque et par virement. Pour votre confort, nos serruriers sont équipés de terminaux de paiement mobile.
          </p>
        </details>

        <details class="bg-gradient-to-br from-secondary-50 to-white rounded-lg shadow-md p-6 group">
          <summary class="font-heading font-bold text-lg text-secondary-900 cursor-pointer list-none flex items-center justify-between">
            Dois-je payer un acompte ?
            <svg class="w-5 h-5 text-primary-600 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <p class="mt-4 text-secondary-600">
            Non, le paiement s'effectue uniquement après l'intervention, une fois le travail terminé et que vous êtes satisfait. Pas d'acompte ni de paiement d'avance.
          </p>
        </details>

        <details class="bg-gradient-to-br from-secondary-50 to-white rounded-lg shadow-md p-6 group">
          <summary class="font-heading font-bold text-lg text-secondary-900 cursor-pointer list-none flex items-center justify-between">
            Y a-t-il des frais de déplacement ?
            <svg class="w-5 h-5 text-primary-600 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <p class="mt-4 text-secondary-600">
            Les frais de déplacement sont inclus dans nos tarifs pour Versailles et les communes environnantes. Le prix annoncé au téléphone est le prix final, déplacement compris.
          </p>
        </details>

        <details class="bg-gradient-to-br from-secondary-50 to-white rounded-lg shadow-md p-6 group">
          <summary class="font-heading font-bold text-lg text-secondary-900 cursor-pointer list-none flex items-center justify-between">
            Puis-je obtenir une facture pour mon assurance ?
            <svg class="w-5 h-5 text-primary-600 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <p class="mt-4 text-secondary-600">
            Oui, nous vous fournissons systématiquement une facture détaillée conforme aux exigences des compagnies d'assurance. Cette facture mentionne tous les éléments nécessaires pour votre déclaration.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-20 bg-gradient-to-br from-secondary-50 to-white">
    <div class="container mx-auto px-4">
      <CTASection variant="primary" showForm={false} />
    </div>
  </section>
</BaseLayout>
