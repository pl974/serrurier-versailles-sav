---
/**
 * Pages dynamiques pour chaque ville
 * Génère une page SEO optimisée pour chaque zone d'intervention
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import CTASection from '@components/CTASection.astro';
import ServiceCard from '@components/ServiceCard.astro';
import { cities, getCityBySlug } from '@data/cities';
import { services } from '@data/services';

export async function getStaticPaths() {
  return cities.map(city => ({
    params: { slug: city.slug },
    props: { city }
  }));
}

const { city } = Astro.props;
const urgentServices = services.filter(s => s.urgency === 'urgente');
const nearbyCities = cities.filter(c => c.id !== city.id).slice(0, 5);

const title = `Serrurier ${city.name} (${city.postalCode}) - Intervention en ${city.interventionTime}`;
const description = `${city.description} Devis gratuit. Service disponible 24h/24 et 7j/7.`;

// Schema pour le local business
const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'Locksmith',
  name: `Serrurier ${city.name}`,
  description: city.description,
  telephone: '+33-1-XX-XX-XX-XX',
  areaServed: {
    '@type': 'City',
    name: city.name,
    postalCode: city.postalCode
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: city.coordinates.lat,
    longitude: city.coordinates.lng
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '00:00',
    closes: '23:59'
  }
};
---

<BaseLayout title={title} description={description} schema={localBusinessSchema}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-primary-600 to-primary-700 text-white py-16 md:py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="mb-4">
          <a href="/villes" class="inline-flex items-center text-primary-100 hover:text-white transition-colors">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            Retour aux zones d'intervention
          </a>
        </div>

        <div class="flex items-center gap-3 mb-6">
          <svg class="w-10 h-10 text-primary-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <div>
            <h1 class="text-4xl md:text-5xl font-heading font-bold">
              Serrurier à {city.name}
            </h1>
            <div class="text-primary-100 text-lg mt-2">{city.postalCode} - Yvelines</div>
          </div>
        </div>

        <p class="text-xl text-primary-100 mb-8">
          {city.description}
        </p>

        <div class="flex flex-col sm:flex-row items-start gap-4">
          <div class="bg-white/10 backdrop-blur-sm rounded-lg px-6 py-4">
            <div class="text-sm text-primary-100 mb-1">Temps d'intervention</div>
            <div class="text-3xl font-bold">{city.interventionTime}</div>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-lg px-6 py-4">
            <div class="text-sm text-primary-100 mb-1">Disponibilité</div>
            <div class="text-xl font-bold">24h/24 - 7j/7</div>
          </div>
          <a href="tel:+33-1-XX-XX-XX-XX" class="bg-white text-primary-600 hover:bg-primary-50 px-8 py-4 rounded-lg font-bold text-lg transition-all hover:scale-105 shadow-xl flex items-center gap-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            01 XX XX XX XX
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Quartiers desservis -->
  {city.nearbyDistricts.length > 0 && (
    <section class="py-16 bg-white border-b border-gray-100">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-heading font-bold text-secondary-900 mb-6 text-center">
            Quartiers desservis à {city.name}
          </h2>
          <p class="text-secondary-600 text-center mb-8 max-w-3xl mx-auto">
            Nos serruriers interviennent dans tous les quartiers de {city.name} avec un temps de réaction garanti.
          </p>
          <div class="flex flex-wrap gap-3 justify-center">
            {city.nearbyDistricts.map(district => (
              <div class="bg-gradient-to-br from-secondary-50 to-white px-6 py-3 rounded-lg border border-gray-200">
                <span class="font-semibold text-secondary-900">{district}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Services disponibles -->
  <section class="py-16 md:py-20 bg-gradient-to-br from-secondary-50 to-white">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-secondary-900 mb-4 text-center">
          Services de serrurerie à {city.name}
        </h2>
        <p class="text-lg text-secondary-600 text-center mb-12 max-w-3xl mx-auto">
          Tous nos services de serrurerie professionnelle sont disponibles à {city.name}. Intervention rapide garantie en {city.interventionTime}.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {urgentServices.map(service => (
            <ServiceCard service={service} />
          ))}
        </div>

        <div class="text-center mt-12">
          <a href="/services" class="inline-block bg-secondary-900 hover:bg-secondary-800 text-white px-8 py-4 rounded-lg font-bold text-lg transition-all hover:scale-105">
            Découvrir tous nos services →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Pourquoi nous choisir à [ville] -->
  <section class="py-16 md:py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-secondary-900 mb-12 text-center">
          Votre serrurier de confiance à {city.name}
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="bg-gradient-to-br from-secondary-50 to-white rounded-xl p-8 shadow-lg">
            <div class="w-16 h-16 bg-primary-100 rounded-full flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>
            <h3 class="text-xl font-heading font-bold text-secondary-900 mb-4">Intervention express</h3>
            <p class="text-secondary-700">
              Basés dans le secteur, nous intervenons en {city.interventionTime} partout à {city.name}. Notre connaissance locale nous permet d'optimiser nos trajets pour arriver au plus vite.
            </p>
          </div>

          <div class="bg-gradient-to-br from-secondary-50 to-white rounded-xl p-8 shadow-lg">
            <div class="w-16 h-16 bg-primary-100 rounded-full flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <h3 class="text-xl font-heading font-bold text-secondary-900 mb-4">Expertise locale</h3>
            <p class="text-secondary-700">
              Nous connaissons parfaitement {city.name} et ses spécificités. Nos serruriers ont l'habitude d'intervenir dans tous types d'habitations de la commune.
            </p>
          </div>

          <div class="bg-gradient-to-br from-secondary-50 to-white rounded-xl p-8 shadow-lg">
            <div class="w-16 h-16 bg-primary-100 rounded-full flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <h3 class="text-xl font-heading font-bold text-secondary-900 mb-4">Disponibilité totale</h3>
            <p class="text-secondary-700">
              Service d'urgence disponible 24 heures sur 24, 7 jours sur 7 à {city.name}. Nous intervenons même la nuit, le weekend et les jours fériés.
            </p>
          </div>

          <div class="bg-gradient-to-br from-secondary-50 to-white rounded-xl p-8 shadow-lg">
            <div class="w-16 h-16 bg-primary-100 rounded-full flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <h3 class="text-xl font-heading font-bold text-secondary-900 mb-4">Tarifs clairs</h3>
            <p class="text-secondary-700">
              Devis gratuit par téléphone avant intervention. Nos prix sont adaptés au marché local de {city.name} et restent compétitifs.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contenu SEO local -->
  <section class="py-16 md:py-20 bg-gradient-to-br from-secondary-50 to-white">
    <div class="container mx-auto px-4 max-w-5xl">
      <div class="prose prose-lg max-w-none">
        <div class="bg-white rounded-xl p-8 shadow-lg mb-8">
          <h2 class="text-3xl font-heading font-bold text-secondary-900 mb-6">
            Serrurier professionnel à {city.name}
          </h2>
          <p class="text-secondary-700 mb-4">
            Notre service de <strong>serrurerie à {city.name}</strong> ({city.postalCode}) est disponible 24h/24 pour tous vos besoins urgents ou planifiés. Avec une population de {city.population.toLocaleString('fr-FR')} habitants, {city.name} nécessite un service de serrurerie réactif et professionnel, capable d'intervenir rapidement en cas d'urgence.
          </p>
          <p class="text-secondary-700 mb-4">
            Nos serruriers connaissent parfaitement {city.name} et interviennent régulièrement dans tous les quartiers de la commune{city.nearbyDistricts.length > 0 ? ` : ${city.nearbyDistricts.slice(0, 3).join(', ')}` : ''}. Cette connaissance locale nous permet de garantir un temps d'intervention de {city.interventionTime} seulement, même en cas d'urgence nocturne.
          </p>
        </div>

        <div class="bg-white rounded-xl p-8 shadow-lg mb-8">
          <h3 class="text-2xl font-heading font-bold text-secondary-900 mb-4">
            Dépannage urgent à {city.name}
          </h3>
          <p class="text-secondary-700 mb-4">
            Vous êtes enfermé dehors à {city.name} ? Votre serrure est bloquée ? Vous avez perdu vos clés ? Notre <strong>service d'urgence</strong> intervient immédiatement pour résoudre votre problème. Nous utilisons des techniques d'ouverture non destructives qui préservent votre serrure et évitent des frais de remplacement inutiles.
          </p>
          <p class="text-secondary-700 mb-4">
            Nos véhicules d'intervention sont équipés de tout le matériel nécessaire pour traiter la majorité des situations de dépannage directement sur place. Que vous habitiez en appartement ou en maison individuelle à {city.name}, nous avons la solution adaptée à votre problème de serrurerie.
          </p>
        </div>

        <div class="bg-white rounded-xl p-8 shadow-lg">
          <h3 class="text-2xl font-heading font-bold text-secondary-900 mb-4">
            Installation et sécurisation à {city.name}
          </h3>
          <p class="text-secondary-700 mb-4">
            Au-delà du dépannage d'urgence, nous proposons tous les services de <strong>serrurerie et de sécurisation</strong> pour les habitants de {city.name} : changement de serrure, installation de serrures multipoints certifiées A2P, blindage de porte, installation de serrures électroniques, etc.
          </p>
          <p class="text-secondary-700">
            Nos experts vous conseillent sur les meilleures solutions pour renforcer la sécurité de votre domicile à {city.name}. Nous proposons uniquement des produits certifiés conformes aux normes d'assurance, avec possibilité de prise en charge par votre assurance habitation.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Villes voisines -->
  {nearbyCities.length > 0 && (
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-heading font-bold text-secondary-900 mb-8 text-center">
            Nous intervenons aussi dans les communes voisines
          </h2>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
            {nearbyCities.map(nearbyCity => (
              <a href={`/villes/${nearbyCity.slug}`} class="bg-gradient-to-br from-secondary-50 to-white hover:from-primary-50 hover:to-primary-100 p-4 rounded-lg text-center transition-all hover:shadow-md border border-gray-100">
                <div class="font-semibold text-secondary-900 mb-1">{nearbyCity.name}</div>
                <div class="text-xs text-secondary-600">{nearbyCity.interventionTime}</div>
              </a>
            ))}
          </div>
          <div class="text-center mt-8">
            <a href="/villes" class="text-primary-600 hover:text-primary-700 font-semibold">
              Voir toutes nos zones →
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="py-16 md:py-20 bg-gradient-to-br from-secondary-50 to-white">
    <div class="container mx-auto px-4">
      <CTASection
        variant="emergency"
        title={`Serrurier d'urgence à ${city.name}`}
        description={`Intervention garantie en ${city.interventionTime}. Service disponible 24h/24 et 7j/7. Devis gratuit par téléphone.`}
        showForm={true}
      />
    </div>
  </section>
</BaseLayout>
