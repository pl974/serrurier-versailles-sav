---
/**
 * Pages dynamiques pour chaque service
 * Génère une page optimisée SEO pour chaque service
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import CTASection from '@components/CTASection.astro';
import ServiceCard from '@components/ServiceCard.astro';
import { services, getServiceBySlug } from '@data/services';
import { cities } from '@data/cities';

export async function getStaticPaths() {
  return services.map(service => ({
    params: { slug: service.slug },
    props: { service }
  }));
}

const { service } = Astro.props;
const relatedServices = services.filter(s => s.id !== service.id && s.urgency === service.urgency).slice(0, 3);
const mainCities = cities.slice(0, 6);

const title = `${service.title} à Versailles - ${service.price} | Serrurier Expert`;
const description = `${service.description} ${service.benefits.slice(0, 2).join('. ')}. Devis gratuit.`;

// Schema pour le service
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description: service.longDescription,
  provider: {
    '@type': 'Locksmith',
    name: 'Serrurier Versailles SAV',
    telephone: '+33-1-XX-XX-XX-XX',
    areaServed: 'Versailles'
  },
  offers: {
    '@type': 'Offer',
    price: service.price,
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock'
  }
};
---

<BaseLayout title={title} description={description} schema={serviceSchema}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-primary-600 to-primary-700 text-white py-16 md:py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="mb-4">
          <a href="/services" class="inline-flex items-center text-primary-100 hover:text-white transition-colors">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            Retour aux services
          </a>
        </div>

        <h1 class="text-4xl md:text-5xl font-heading font-bold mb-6">
          {service.title} à Versailles
        </h1>
        <p class="text-xl text-primary-100 mb-8">
          {service.longDescription}
        </p>

        <div class="flex flex-col sm:flex-row items-start gap-4">
          <div class="bg-white/10 backdrop-blur-sm rounded-lg px-6 py-4">
            <div class="text-sm text-primary-100 mb-1">À partir de</div>
            <div class="text-3xl font-bold">{service.price}</div>
          </div>
          <a href="tel:+33-1-XX-XX-XX-XX" class="bg-white text-primary-600 hover:bg-primary-50 px-8 py-4 rounded-lg font-bold text-lg transition-all hover:scale-105 shadow-xl flex items-center gap-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            Appeler maintenant
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Avantages du service -->
  <section class="py-16 md:py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-secondary-900 mb-12 text-center">
          Les avantages de notre service
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {service.benefits.map(benefit => (
            <div class="flex items-start gap-4 bg-gradient-to-br from-secondary-50 to-white p-6 rounded-xl">
              <svg class="w-8 h-8 text-primary-600 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <div>
                <h3 class="font-heading font-bold text-lg text-secondary-900 mb-2">{benefit}</h3>
                <p class="text-secondary-600">Service professionnel garanti par nos experts certifiés.</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Détails et processus -->
  <section class="py-16 md:py-20 bg-gradient-to-br from-secondary-50 to-white">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-secondary-900 mb-12 text-center">
          Comment ça marche ?
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="bg-white rounded-xl p-8 shadow-lg text-center">
            <div class="w-16 h-16 bg-primary-100 rounded-full flex items-center justify-center mx-auto mb-6">
              <span class="text-3xl font-bold text-primary-600">1</span>
            </div>
            <h3 class="text-xl font-heading font-bold text-secondary-900 mb-4">Contactez-nous</h3>
            <p class="text-secondary-600">
              Appelez-nous ou remplissez le formulaire en ligne. Nous vous répondons immédiatement et établissons un devis gratuit.
            </p>
          </div>

          <div class="bg-white rounded-xl p-8 shadow-lg text-center">
            <div class="w-16 h-16 bg-primary-100 rounded-full flex items-center justify-center mx-auto mb-6">
              <span class="text-3xl font-bold text-primary-600">2</span>
            </div>
            <h3 class="text-xl font-heading font-bold text-secondary-900 mb-4">Intervention rapide</h3>
            <p class="text-secondary-600">
              Notre serrurier se déplace en moins de 30 minutes avec tout le matériel nécessaire pour résoudre votre problème.
            </p>
          </div>

          <div class="bg-white rounded-xl p-8 shadow-lg text-center">
            <div class="w-16 h-16 bg-primary-100 rounded-full flex items-center justify-center mx-auto mb-6">
              <span class="text-3xl font-bold text-primary-600">3</span>
            </div>
            <h3 class="text-xl font-heading font-bold text-secondary-900 mb-4">Problème résolu</h3>
            <p class="text-secondary-600">
              Travail effectué dans les règles de l'art avec garantie. Vous recevez une facture détaillée pour votre assurance.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Zones d'intervention -->
  <section class="py-16 md:py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-secondary-900 mb-8 text-center">
          Service disponible dans toute la région de Versailles
        </h2>
        <p class="text-lg text-secondary-600 text-center mb-12 max-w-3xl mx-auto">
          Notre service de {service.title.toLowerCase()} est disponible à Versailles et dans toutes les communes environnantes des Yvelines.
        </p>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
          {mainCities.map(city => (
            <a href={`/villes/${city.slug}`} class="bg-gradient-to-br from-secondary-50 to-white hover:from-primary-50 hover:to-primary-100 p-4 rounded-lg text-center transition-all hover:shadow-md border border-gray-100">
              <div class="font-semibold text-secondary-900">{city.name}</div>
              <div class="text-xs text-secondary-600 mt-1">{city.interventionTime}</div>
            </a>
          ))}
        </div>

        <div class="text-center mt-8">
          <a href="/villes" class="text-primary-600 hover:text-primary-700 font-semibold">
            Voir toutes les villes →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services connexes -->
  {relatedServices.length > 0 && (
    <section class="py-16 md:py-20 bg-gradient-to-br from-secondary-50 to-white">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-secondary-900 mb-12 text-center">
            Services complémentaires
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {relatedServices.map(relatedService => (
              <ServiceCard service={relatedService} />
            ))}
          </div>

          <div class="text-center mt-12">
            <a href="/services" class="inline-block bg-secondary-900 hover:bg-secondary-800 text-white px-8 py-4 rounded-lg font-bold text-lg transition-all hover:scale-105">
              Voir tous nos services →
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="py-16 md:py-20 bg-white">
    <div class="container mx-auto px-4">
      <CTASection
        variant="emergency"
        title={`Besoin de ${service.title.toLowerCase()} ?`}
        description={`Contactez-nous maintenant pour une intervention rapide. ${service.price} - Devis gratuit par téléphone.`}
        showForm={true}
      />
    </div>
  </section>
</BaseLayout>
