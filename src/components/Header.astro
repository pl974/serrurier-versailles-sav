---
/**
 * Header principal avec navigation optimisée pour la conversion
 * CTA visible et navigation claire
 */

import { services } from '@data/services';
import { getMainCities } from '@data/cities';

const mainServices = services.slice(0, 4);
const mainCities = getMainCities().slice(0, 5);
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white shadow-md" id="main-header">
  <div class="container mx-auto px-4">
    <!-- Top bar avec informations importantes -->
    <div class="hidden md:flex items-center justify-between py-2 text-sm border-b border-gray-100">
      <div class="flex items-center gap-6">
        <a href="tel:+33-1-XX-XX-XX-XX" class="flex items-center gap-2 text-secondary-700 hover:text-primary-600 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <span class="font-medium">01 XX XX XX XX</span>
        </a>
        <div class="flex items-center gap-2 text-secondary-600">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span>Disponible 24h/24 - 7j/7</span>
        </div>
      </div>
      <div class="flex items-center gap-2 text-green-600 font-medium">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <span>Intervention en 30 min</span>
      </div>
    </div>

    <!-- Main navigation -->
    <nav class="flex items-center justify-between py-4">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-12 h-12 bg-primary-600 rounded-lg flex items-center justify-center group-hover:bg-primary-700 transition-colors">
          <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
          </svg>
        </div>
        <div>
          <div class="text-xl font-heading font-bold text-secondary-900">Serrurier Versailles</div>
          <div class="text-xs text-secondary-600">Expert en serrurerie depuis 2010</div>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-8">
        <a href="/" class="text-secondary-700 hover:text-primary-600 font-medium transition-colors">Accueil</a>

        <div class="relative group">
          <button class="text-secondary-700 hover:text-primary-600 font-medium transition-colors flex items-center gap-1">
            Nos services
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="absolute top-full left-0 mt-2 w-64 bg-white rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
            <div class="py-2">
              {mainServices.map(service => (
                <a href={`/services/${service.slug}`} class="block px-4 py-2 text-secondary-700 hover:bg-primary-50 hover:text-primary-600 transition-colors">
                  {service.title}
                </a>
              ))}
              <a href="/services" class="block px-4 py-2 text-primary-600 font-medium hover:bg-primary-50 transition-colors border-t border-gray-100 mt-2">
                Voir tous les services →
              </a>
            </div>
          </div>
        </div>

        <div class="relative group">
          <button class="text-secondary-700 hover:text-primary-600 font-medium transition-colors flex items-center gap-1">
            Nos zones
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="absolute top-full left-0 mt-2 w-56 bg-white rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
            <div class="py-2">
              {mainCities.map(city => (
                <a href={`/villes/${city.slug}`} class="block px-4 py-2 text-secondary-700 hover:bg-primary-50 hover:text-primary-600 transition-colors">
                  {city.name}
                </a>
              ))}
              <a href="/villes" class="block px-4 py-2 text-primary-600 font-medium hover:bg-primary-50 transition-colors border-t border-gray-100 mt-2">
                Toutes les villes →
              </a>
            </div>
          </div>
        </div>

        <a href="/contact" class="text-secondary-700 hover:text-primary-600 font-medium transition-colors">Contact</a>
      </div>

      <!-- CTA Button -->
      <div class="flex items-center gap-4">
        <a href="tel:+33-1-XX-XX-XX-XX" class="hidden md:block bg-primary-600 hover:bg-primary-700 text-white px-6 py-3 rounded-lg font-semibold transition-all hover:scale-105 shadow-lg">
          Appel d'urgence
        </a>

        <!-- Mobile menu button -->
        <button id="mobile-menu-button" class="lg:hidden p-2 text-secondary-700 hover:text-primary-600" aria-label="Menu mobile">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white border-t border-gray-100">
    <div class="container mx-auto px-4 py-4">
      <div class="space-y-2">
        <a href="/" class="block py-2 text-secondary-700 hover:text-primary-600 font-medium">Accueil</a>
        <div class="border-t border-gray-100 pt-2">
          <div class="text-xs font-semibold text-secondary-400 uppercase mb-2">Services</div>
          {mainServices.map(service => (
            <a href={`/services/${service.slug}`} class="block py-2 pl-4 text-secondary-600 hover:text-primary-600">
              {service.title}
            </a>
          ))}
          <a href="/services" class="block py-2 pl-4 text-primary-600 font-medium">Tous les services →</a>
        </div>
        <div class="border-t border-gray-100 pt-2">
          <div class="text-xs font-semibold text-secondary-400 uppercase mb-2">Zones</div>
          {mainCities.map(city => (
            <a href={`/villes/${city.slug}`} class="block py-2 pl-4 text-secondary-600 hover:text-primary-600">
              {city.name}
            </a>
          ))}
        </div>
        <a href="/contact" class="block py-2 text-secondary-700 hover:text-primary-600 font-medium border-t border-gray-100 pt-2">Contact</a>
      </div>
      <a href="tel:+33-1-XX-XX-XX-XX" class="mt-4 block bg-primary-600 hover:bg-primary-700 text-white px-6 py-3 rounded-lg font-semibold text-center transition-colors">
        Appel d'urgence: 01 XX XX XX XX
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  document.getElementById('mobile-menu-button')?.addEventListener('click', () => {
    const menu = document.getElementById('mobile-menu');
    menu?.classList.toggle('hidden');
  });

  // Header scroll effect
  let lastScroll = 0;
  window.addEventListener('scroll', () => {
    const header = document.getElementById('main-header');
    const currentScroll = window.pageYOffset;

    if (currentScroll > 100) {
      header?.classList.add('shadow-lg');
    } else {
      header?.classList.remove('shadow-lg');
    }

    lastScroll = currentScroll;
  });
</script>
