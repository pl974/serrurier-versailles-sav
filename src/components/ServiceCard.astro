---
/**
 * Carte de service réutilisable
 * Affiche un service avec ses informations clés
 */

import type { Service } from '@data/services';

interface Props {
  service: Service;
  featured?: boolean;
}

const { service, featured = false } = Astro.props;

const urgencyColors = {
  urgente: 'bg-red-100 text-red-700 border-red-200',
  standard: 'bg-blue-100 text-blue-700 border-blue-200',
  planifiable: 'bg-green-100 text-green-700 border-green-200'
};

const urgencyLabels = {
  urgente: 'Urgence 24h/24',
  standard: 'Intervention standard',
  planifiable: 'Sur rendez-vous'
};
---

<article class={`bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden h-full flex flex-col ${featured ? 'border-2 border-primary-500' : 'border border-gray-100'}`}>
  {featured && (
    <div class="bg-primary-600 text-white text-center py-2 px-4 text-sm font-bold">
      Service le plus demandé
    </div>
  )}

  <div class="p-6 flex-1 flex flex-col">
    <!-- Header -->
    <div class="flex items-start justify-between mb-4">
      <div class="flex-1">
        <h3 class="text-xl font-heading font-bold text-secondary-900 mb-2">
          {service.title}
        </h3>
        <span class={`inline-block px-3 py-1 rounded-full text-xs font-medium border ${urgencyColors[service.urgency]}`}>
          {urgencyLabels[service.urgency]}
        </span>
      </div>
    </div>

    <!-- Description -->
    <p class="text-secondary-600 mb-4 flex-1">
      {service.description}
    </p>

    <!-- Benefits -->
    <ul class="space-y-2 mb-6">
      {service.benefits.slice(0, 3).map(benefit => (
        <li class="flex items-start gap-2 text-sm text-secondary-700">
          <svg class="w-5 h-5 text-primary-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          <span>{benefit}</span>
        </li>
      ))}
    </ul>

    <!-- Footer -->
    <div class="border-t border-gray-100 pt-4 mt-auto">
      <div class="flex items-center justify-between mb-4">
        <div>
          <div class="text-xs text-secondary-500 mb-1">À partir de</div>
          <div class="text-2xl font-bold text-primary-600">{service.price}</div>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-2">
        <a
          href={`/services/${service.slug}`}
          class="flex-1 text-center bg-primary-600 hover:bg-primary-700 text-white px-4 py-2.5 rounded-lg font-semibold transition-colors text-sm"
        >
          En savoir plus
        </a>
        <a
          href="tel:+33-1-XX-XX-XX-XX"
          class="flex-1 text-center border-2 border-primary-600 text-primary-600 hover:bg-primary-50 px-4 py-2.5 rounded-lg font-semibold transition-colors text-sm"
        >
          Appeler
        </a>
      </div>
    </div>
  </div>
</article>
