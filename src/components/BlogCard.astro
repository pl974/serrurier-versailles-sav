---
/**
 * Carte d'article de blog réutilisable
 * Affiche un aperçu d'article avec image, catégorie, tags, temps de lecture
 */

import type { BlogPost } from '../data/blogPosts';

interface Props {
  post: BlogPost;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;

// Couleurs par catégorie
const categoryColors = {
  guide: 'bg-blue-100 text-blue-800',
  conseils: 'bg-green-100 text-green-800',
  actualites: 'bg-purple-100 text-purple-800',
  securite: 'bg-red-100 text-red-800'
};

const categoryLabels = {
  guide: 'Guide',
  conseils: 'Conseils',
  actualites: 'Actualités',
  securite: 'Sécurité'
};

// Formater la date
function formatDate(dateString: string): string {
  const date = new Date(dateString);
  return new Intl.DateTimeFormat('fr-FR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  }).format(date);
}
---

<article class={`bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 ${featured ? 'border-2 border-primary-500' : ''}`}>
  {/* Image */}
  <a href={`/blog/${post.slug}`} class="block relative overflow-hidden group">
    <img
      src={post.image}
      alt={post.title}
      class="w-full h-64 object-cover transition-transform duration-300 group-hover:scale-110"
      loading="lazy"
    />
    {featured && (
      <div class="absolute top-4 left-4 bg-primary-600 text-white px-3 py-1 rounded-full text-sm font-bold flex items-center gap-1">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
        </svg>
        À la une
      </div>
    )}
    {/* Catégorie badge */}
    <div class="absolute top-4 right-4">
      <span class={`px-3 py-1 rounded-full text-xs font-semibold ${categoryColors[post.category]}`}>
        {categoryLabels[post.category]}
      </span>
    </div>
  </a>

  {/* Contenu */}
  <div class="p-6">
    {/* Meta info */}
    <div class="flex items-center gap-4 mb-3 text-sm text-secondary-600">
      <div class="flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        <span>{formatDate(post.publishedAt)}</span>
      </div>
      <div class="flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span>{post.readingTime} min de lecture</span>
      </div>
    </div>

    {/* Titre */}
    <a href={`/blog/${post.slug}`} class="block group">
      <h3 class="text-xl font-heading font-bold text-secondary-900 mb-3 group-hover:text-primary-600 transition-colors line-clamp-2">
        {post.title}
      </h3>
    </a>

    {/* Extrait */}
    <p class="text-secondary-600 mb-4 line-clamp-3">
      {post.excerpt}
    </p>

    {/* Tags */}
    {post.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-4">
        {post.tags.slice(0, 3).map(tag => (
          <span class="text-xs bg-secondary-100 text-secondary-700 px-2 py-1 rounded">
            #{tag}
          </span>
        ))}
      </div>
    )}

    {/* Auteur et CTA */}
    <div class="flex items-center justify-between pt-4 border-t border-gray-100">
      <div class="flex items-center gap-2 text-sm text-secondary-600">
        <div class="w-8 h-8 bg-primary-100 rounded-full flex items-center justify-center">
          <svg class="w-4 h-4 text-primary-600" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
          </svg>
        </div>
        <span class="font-medium">{post.author}</span>
      </div>
      <a
        href={`/blog/${post.slug}`}
        class="inline-flex items-center gap-2 text-primary-600 hover:text-primary-700 font-semibold text-sm group"
      >
        Lire l'article
        <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</article>
