---
/**
 * Composant CTA (Call-to-Action) réutilisable
 * Optimisé pour la conversion avec différentes variantes
 */

interface Props {
  variant?: 'primary' | 'secondary' | 'emergency';
  title?: string;
  description?: string;
  phoneNumber?: string;
  showForm?: boolean;
  className?: string;
}

const {
  variant = 'primary',
  title,
  description,
  phoneNumber = '+33-1-XX-XX-XX-XX',
  showForm = false,
  className = ''
} = Astro.props;

const variants = {
  primary: {
    bg: 'bg-gradient-to-br from-primary-600 to-primary-700',
    title: title || 'Besoin d\'un serrurier en urgence ?',
    description: description || 'Intervention rapide en moins de 30 minutes à Versailles et ses environs. Devis gratuit par téléphone.'
  },
  secondary: {
    bg: 'bg-gradient-to-br from-secondary-800 to-secondary-900',
    title: title || 'Demandez votre devis gratuit',
    description: description || 'Remplissez le formulaire ou appelez-nous directement pour obtenir un devis personnalisé sans engagement.'
  },
  emergency: {
    bg: 'bg-gradient-to-br from-red-600 to-red-700',
    title: title || 'Urgence serrurerie 24h/24',
    description: description || 'Porte claquée, clé cassée, cambriolage ? Appelez-nous maintenant pour une intervention immédiate.'
  }
};

const config = variants[variant];
---

<section class={`${config.bg} text-white py-12 md:py-16 rounded-2xl ${className}`}>
  <div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4">
        {config.title}
      </h2>
      <p class="text-lg md:text-xl text-white/90 mb-8 max-w-2xl mx-auto">
        {config.description}
      </p>

      {!showForm ? (
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={`tel:${phoneNumber}`}
            class="group bg-white text-primary-600 hover:bg-primary-50 px-8 py-4 rounded-lg font-bold text-lg transition-all hover:scale-105 shadow-xl flex items-center gap-3 w-full sm:w-auto justify-center"
          >
            <svg class="w-6 h-6 group-hover:animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <span>01 XX XX XX XX</span>
          </a>
          <a
            href="/contact"
            class="border-2 border-white text-white hover:bg-white hover:text-primary-600 px-8 py-4 rounded-lg font-bold text-lg transition-all w-full sm:w-auto text-center"
          >
            Formulaire de contact
          </a>
        </div>
      ) : (
        <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 md:p-8 max-w-2xl mx-auto">
          <form class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <input
                type="text"
                name="name"
                placeholder="Votre nom"
                required
                class="px-4 py-3 rounded-lg bg-white/90 text-secondary-900 placeholder-secondary-500 focus:outline-none focus:ring-2 focus:ring-white"
              />
              <input
                type="tel"
                name="phone"
                placeholder="Téléphone"
                required
                class="px-4 py-3 rounded-lg bg-white/90 text-secondary-900 placeholder-secondary-500 focus:outline-none focus:ring-2 focus:ring-white"
              />
            </div>
            <input
              type="email"
              name="email"
              placeholder="Email"
              class="w-full px-4 py-3 rounded-lg bg-white/90 text-secondary-900 placeholder-secondary-500 focus:outline-none focus:ring-2 focus:ring-white"
            />
            <select
              name="service"
              required
              class="w-full px-4 py-3 rounded-lg bg-white/90 text-secondary-900 focus:outline-none focus:ring-2 focus:ring-white"
            >
              <option value="">Sélectionnez un service</option>
              <option value="ouverture-porte">Ouverture de porte</option>
              <option value="changement-serrure">Changement de serrure</option>
              <option value="depannage-urgence">Dépannage en urgence</option>
              <option value="blindage-porte">Blindage de porte</option>
              <option value="autre">Autre</option>
            </select>
            <textarea
              name="message"
              placeholder="Décrivez votre besoin (optionnel)"
              rows="3"
              class="w-full px-4 py-3 rounded-lg bg-white/90 text-secondary-900 placeholder-secondary-500 focus:outline-none focus:ring-2 focus:ring-white"
            ></textarea>
            <button
              type="submit"
              class="w-full bg-secondary-900 hover:bg-secondary-800 text-white px-8 py-4 rounded-lg font-bold text-lg transition-all hover:scale-105 shadow-xl"
            >
              Envoyer ma demande
            </button>
          </form>
          <p class="text-sm text-white/80 mt-4 text-center">
            Ou appelez directement : <a href={`tel:${phoneNumber}`} class="font-bold underline hover:text-white">01 XX XX XX XX</a>
          </p>
        </div>
      )}

      <!-- Trust indicators -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12 max-w-3xl mx-auto">
        <div class="flex flex-col items-center">
          <svg class="w-12 h-12 mb-2 text-white/90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <div class="text-lg font-bold">Intervention 30 min</div>
          <div class="text-sm text-white/80">Partout à Versailles</div>
        </div>
        <div class="flex flex-col items-center">
          <svg class="w-12 h-12 mb-2 text-white/90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          <div class="text-lg font-bold">Serruriers certifiés</div>
          <div class="text-sm text-white/80">Professionnels qualifiés</div>
        </div>
        <div class="flex flex-col items-center">
          <svg class="w-12 h-12 mb-2 text-white/90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <div class="text-lg font-bold">Prix transparents</div>
          <div class="text-sm text-white/80">Devis gratuit sans surprise</div>
        </div>
      </div>
    </div>
  </div>
</section>
