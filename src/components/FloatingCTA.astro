---
/**
 * Composant de bouton CTA flottant
 * Reste visible en bas de l'écran pour maximiser la conversion
 */

interface Props {
  phoneNumber?: string;
  variant?: 'phone' | 'both';
}

const {
  phoneNumber = '+33-1-XX-XX-XX-XX',
  variant = 'both'
} = Astro.props;
---

<!-- Bouton flottant pour mobile -->
<div class="fixed bottom-0 left-0 right-0 z-40 md:hidden bg-white border-t-2 border-primary-600 shadow-2xl" id="mobile-floating-cta">
  <div class="container mx-auto px-4 py-3">
    <div class="flex items-center gap-3">
      <a
        href={`tel:${phoneNumber}`}
        class="flex-1 bg-primary-600 hover:bg-primary-700 text-white px-6 py-4 rounded-lg font-bold text-center transition-all flex items-center justify-center gap-2 shadow-lg"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        <span>Appeler</span>
      </a>
      {variant === 'both' && (
        <a
          href="/contact"
          class="flex-1 bg-secondary-700 hover:bg-secondary-800 text-white px-6 py-4 rounded-lg font-bold text-center transition-all"
        >
          Devis
        </a>
      )}
    </div>
  </div>
</div>

<!-- Bouton flottant pour desktop -->
<div class="hidden md:block fixed bottom-8 right-8 z-40" id="desktop-floating-cta">
  <a
    href={`tel:${phoneNumber}`}
    class="group bg-primary-600 hover:bg-primary-700 text-white px-8 py-5 rounded-full font-bold text-lg transition-all shadow-2xl flex items-center gap-3 hover:scale-110 animate-pulse"
  >
    <svg class="w-7 h-7 group-hover:rotate-12 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
    </svg>
    <div class="text-left">
      <div class="text-xs opacity-90">Urgence 24h/24</div>
      <div class="text-lg font-bold">01 XX XX XX XX</div>
    </div>
  </a>
</div>

<script>
  // Afficher/masquer le bouton flottant au scroll
  let lastScroll = 0;
  const mobileCta = document.getElementById('mobile-floating-cta');
  const desktopCta = document.getElementById('desktop-floating-cta');

  window.addEventListener('scroll', () => {
    const currentScroll = window.pageYOffset;

    if (currentScroll > 300) {
      mobileCta?.classList.remove('translate-y-full');
      desktopCta?.classList.remove('translate-y-32', 'opacity-0');
    } else {
      mobileCta?.classList.add('translate-y-full');
      desktopCta?.classList.add('translate-y-32', 'opacity-0');
    }

    lastScroll = currentScroll;
  });
</script>

<style>
  #mobile-floating-cta {
    transition: transform 0.3s ease-in-out;
  }

  #desktop-floating-cta {
    transition: transform 0.3s ease-in-out, opacity 0.3s ease-in-out;
  }
</style>
