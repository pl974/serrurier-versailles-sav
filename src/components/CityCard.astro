---
/**
 * Carte de ville réutilisable
 * Affiche une zone d'intervention avec les informations clés
 */

import type { City } from '@data/cities';

interface Props {
  city: City;
}

const { city } = Astro.props;
---

<article class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-100 h-full flex flex-col">
  <div class="p-6 flex-1 flex flex-col">
    <!-- Header -->
    <div class="flex items-start justify-between mb-4">
      <div class="flex-1">
        <h3 class="text-xl font-heading font-bold text-secondary-900 mb-2">
          {city.name}
        </h3>
        <div class="flex items-center gap-2 text-sm text-secondary-600">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <span>{city.postalCode}</span>
        </div>
      </div>
      <div class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-xs font-medium border border-green-200 whitespace-nowrap">
        {city.interventionTime}
      </div>
    </div>

    <!-- Description -->
    <p class="text-secondary-600 mb-4 flex-1 text-sm">
      {city.description}
    </p>

    <!-- Districts -->
    {city.nearbyDistricts.length > 0 && (
      <div class="mb-4">
        <div class="text-xs font-semibold text-secondary-500 uppercase mb-2">Quartiers desservis</div>
        <div class="flex flex-wrap gap-1.5">
          {city.nearbyDistricts.slice(0, 4).map(district => (
            <span class="bg-secondary-50 text-secondary-700 px-2 py-1 rounded text-xs">
              {district}
            </span>
          ))}
          {city.nearbyDistricts.length > 4 && (
            <span class="bg-secondary-50 text-secondary-700 px-2 py-1 rounded text-xs">
              +{city.nearbyDistricts.length - 4}
            </span>
          )}
        </div>
      </div>
    )}

    <!-- Footer -->
    <div class="border-t border-gray-100 pt-4 mt-auto">
      <div class="flex flex-col gap-2">
        <a
          href={`/villes/${city.slug}`}
          class="text-center bg-primary-600 hover:bg-primary-700 text-white px-4 py-2.5 rounded-lg font-semibold transition-colors text-sm"
        >
          Voir les services à {city.name}
        </a>
        <a
          href="tel:+33-1-XX-XX-XX-XX"
          class="text-center border-2 border-secondary-300 text-secondary-700 hover:border-primary-600 hover:text-primary-600 px-4 py-2.5 rounded-lg font-semibold transition-colors text-sm"
        >
          Intervention immédiate
        </a>
      </div>
    </div>
  </div>
</article>
