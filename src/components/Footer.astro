---
/**
 * Footer avec maillage interne optimisé et informations légales
 */

import { services } from '@data/services';
import { cities } from '@data/cities';

const mainServices = services.slice(0, 6);
const mainCities = cities.slice(0, 8);
const currentYear = new Date().getFullYear();
---

<footer class="bg-secondary-900 text-secondary-100">
  <div class="container mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-8">
      <!-- About -->
      <div>
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 bg-primary-600 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
            </svg>
          </div>
          <div class="text-lg font-heading font-bold text-white">Serrurier Versailles</div>
        </div>
        <p class="text-sm text-secondary-300 mb-4">
          Expert en serrurerie à Versailles et ses environs. Service professionnel disponible 24h/24 pour tous vos besoins en serrurerie d'urgence et installation.
        </p>
        <div class="flex flex-col gap-2">
          <a href="tel:+33-1-XX-XX-XX-XX" class="flex items-center gap-2 text-white hover:text-primary-400 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <span class="font-semibold">01 XX XX XX XX</span>
          </a>
          <div class="flex items-center gap-2 text-secondary-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span class="text-sm">Ouvert 24h/24 et 7j/7</span>
          </div>
        </div>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-white font-heading font-bold text-lg mb-4">Nos services</h3>
        <ul class="space-y-2">
          {mainServices.map(service => (
            <li>
              <a href={`/services/${service.slug}`} class="text-secondary-300 hover:text-primary-400 transition-colors text-sm">
                {service.title}
              </a>
            </li>
          ))}
          <li>
            <a href="/services" class="text-primary-400 hover:text-primary-300 transition-colors text-sm font-medium">
              Tous nos services →
            </a>
          </li>
        </ul>
      </div>

      <!-- Zones d'intervention -->
      <div>
        <h3 class="text-white font-heading font-bold text-lg mb-4">Zones d'intervention</h3>
        <ul class="space-y-2">
          {mainCities.map(city => (
            <li>
              <a href={`/villes/${city.slug}`} class="text-secondary-300 hover:text-primary-400 transition-colors text-sm">
                Serrurier {city.name}
              </a>
            </li>
          ))}
          <li>
            <a href="/villes" class="text-primary-400 hover:text-primary-300 transition-colors text-sm font-medium">
              Toutes les villes →
            </a>
          </li>
        </ul>
      </div>

      <!-- Informations -->
      <div>
        <h3 class="text-white font-heading font-bold text-lg mb-4">Informations</h3>
        <ul class="space-y-2">
          <li>
            <a href="/contact" class="text-secondary-300 hover:text-primary-400 transition-colors text-sm">
              Nous contacter
            </a>
          </li>
          <li>
            <a href="/tarifs" class="text-secondary-300 hover:text-primary-400 transition-colors text-sm">
              Nos tarifs
            </a>
          </li>
          <li>
            <a href="/urgence" class="text-secondary-300 hover:text-primary-400 transition-colors text-sm">
              Service d'urgence
            </a>
          </li>
          <li>
            <a href="/mentions-legales" class="text-secondary-300 hover:text-primary-400 transition-colors text-sm">
              Mentions légales
            </a>
          </li>
          <li>
            <a href="/confidentialite" class="text-secondary-300 hover:text-primary-400 transition-colors text-sm">
              Politique de confidentialité
            </a>
          </li>
          <li>
            <a href="/cgv" class="text-secondary-300 hover:text-primary-400 transition-colors text-sm">
              CGV
            </a>
          </li>
        </ul>

        <!-- Trust badges -->
        <div class="mt-6 space-y-2">
          <div class="flex items-center gap-2 text-green-400 text-sm">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span>Serruriers certifiés</span>
          </div>
          <div class="flex items-center gap-2 text-green-400 text-sm">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span>Intervention garantie</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-secondary-800 pt-8">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-secondary-400 text-sm text-center md:text-left">
          © {currentYear} Serrurier Versailles SAV. Tous droits réservés.
        </p>
        <div class="flex items-center gap-2 text-secondary-400 text-sm">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <span>Versailles et environs - Yvelines (78)</span>
        </div>
      </div>
    </div>
  </div>
</footer>
