---
/**
 * Composant de comparaison avant/après
 * Idéal pour montrer les réalisations de serrurerie
 */

interface Props {
  beforeImage: string;
  afterImage: string;
  beforeLabel?: string;
  afterLabel?: string;
  title: string;
  description?: string;
}

const {
  beforeImage,
  afterImage,
  beforeLabel = 'Avant',
  afterLabel = 'Après',
  title,
  description
} = Astro.props;
---

<div class="bg-white rounded-xl shadow-lg overflow-hidden">
  <div class="p-6">
    <h3 class="text-2xl font-heading font-bold text-secondary-900 mb-2">
      {title}
    </h3>
    {description && (
      <p class="text-secondary-600 mb-4">{description}</p>
    )}
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-0 md:gap-1 bg-gray-100">
    <!-- Image avant -->
    <div class="relative group overflow-hidden">
      <div class="aspect-[4/3] bg-gray-200">
        <img
          src={beforeImage}
          alt={`${title} - Avant intervention`}
          class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
          loading="lazy"
        />
      </div>
      <div class="absolute top-4 left-4 bg-red-600 text-white px-4 py-2 rounded-lg font-bold shadow-lg">
        {beforeLabel}
      </div>
    </div>

    <!-- Image après -->
    <div class="relative group overflow-hidden">
      <div class="aspect-[4/3] bg-gray-200">
        <img
          src={afterImage}
          alt={`${title} - Après intervention`}
          class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
          loading="lazy"
        />
      </div>
      <div class="absolute top-4 left-4 bg-green-600 text-white px-4 py-2 rounded-lg font-bold shadow-lg">
        {afterLabel}
      </div>
      <!-- Badge de qualité -->
      <div class="absolute bottom-4 right-4 bg-white/90 backdrop-blur-sm px-4 py-2 rounded-lg shadow-lg flex items-center gap-2">
        <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <span class="text-sm font-semibold text-secondary-900">Travail garanti</span>
      </div>
    </div>
  </div>

  <div class="p-6 bg-gradient-to-br from-secondary-50 to-white border-t border-gray-100">
    <div class="flex items-center gap-6 text-sm">
      <div class="flex items-center gap-2 text-secondary-700">
        <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span>Intervention rapide</span>
      </div>
      <div class="flex items-center gap-2 text-secondary-700">
        <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span>Travail professionnel</span>
      </div>
      <div class="flex items-center gap-2 text-secondary-700">
        <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
        <span>Garanti</span>
      </div>
    </div>
  </div>
</div>
